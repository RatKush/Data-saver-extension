# OS cruft
.DS_Store

# Chrome's own runtime-generated ruleset index cache — regenerated
# automatically whenever the unpacked extension loads, not source.
_metadata/

# Build output — regenerate with scripts/package.sh
dist/

# Private business data — Chrome Web Store analytics exports.
# These contain install/uninstall counts, weekly users and region breakdowns.
# Remove these lines if you actually want them version-controlled.
Installs_uninstall data.csv
Weekly users over time*.csv
Weekly users over time*.xlsx
